---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import { getCollection } from 'astro:content';
import { FileDown, Linkedin } from 'lucide-astro';

const experiences = await getCollection('experience');
const sortedExperiences = experiences.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const skillsMatrix = [
  {
    domain: 'Core Languages',
    description: 'Languages used for building test frameworks, automation scripts, and backend tools.',
    skills: ['Java (8 / 17)', 'JavaScript / TypeScript', 'SQL (PostgreSQL & MySQL)', 'Shell / Bash', 'Node.js'],
  },
  {
    domain: 'Test Automation Frameworks',
    description: 'Frameworks for testing backend APIs, web frontends, and mobile applications.',
    skills: ['Playwright (Java)', 'REST Assured', 'TestNG', 'Appium (Mobile)', 'Selenium WebDriver', 'Cucumber (BDD)'],
  },
  {
    domain: 'Mocking & Test Isolation',
    description: 'Simulating third-party payment gateways and external APIs to prevent unstable staging dependencies.',
    skills: ['Express.js Mock Server', 'WireMock', 'Webhook Dispatchers', 'Postman Mocking', 'JSON Server'],
  },
  {
    domain: 'Databases & Verification',
    description: 'Validating data integrity and transaction balances directly in the database.',
    skills: ['PostgreSQL', 'MySQL', 'Direct JDBC Assertions', 'Redis'],
  },
  {
    domain: 'Observability & Reporting',
    description: 'Generating clear, actionable test reports with screenshots and failure stack traces.',
    skills: ['Allure Report 3', 'Extent Reports', 'Postman / Newman CLI', 'Custom TestNG Listeners'],
  },
  {
    domain: 'CI/CD & Developer Tools',
    description: 'Automating test triggers, pipeline gates, and team notifications.',
    skills: ['Jenkins CI', 'Bitbucket Pipelines', 'Slack Bolt API (Socket Mode)', 'Git / GitHub', 'Docker'],
  },
  {
    domain: 'Engineering Practices',
    description: 'Proven patterns for making test suites reliable, maintainable, and fast.',
    skills: [
      'Shift-Left Quality Strategy',
      'Flaky Test Elimination',
      'Page / Service Object Model (POM / SOM)',
      'Smart Auto-Waiting (No Thread.sleep)',
      'Parallel Test Execution',
      'API Contract Validation',
    ],
  },
];
---

<BaseLayout
  title="Experience & Technical Skills | Alfath Febriadi Pratama"
  description="Career timeline across Kredivo Group and Bank Central Asia, showcasing test automation frameworks, developer tools, and technical skill set."
>
  <!-- Page Header -->
  <section class="py-8 sm:py-12 border-b border-zinc-800/80 mb-12">
    <div class="max-w-4xl">
      <div class="flex items-center gap-3 mb-4">
        <StatusBadge text="Track Record: 5+ YoE" status="passing" size="sm" pulse={false} />
        <span class="text-xs font-mono text-zinc-500 uppercase tracking-widest">Career & Skills</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
        Work Experience & Skills
      </h1>
      <p class="text-base sm:text-lg text-zinc-400 leading-relaxed max-w-2xl">
        5+ years building test automation suites, mock services, and developer productivity tools across high-volume fintech and digital banking systems.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/resume.pdf"
          target="_blank"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-mono font-semibold text-zinc-950 bg-emerald-400 hover:bg-emerald-300 transition-all shadow-md"
        >
          <FileDown size={16} class="w-4 h-4" />
          <span>Download Resume (PDF)</span>
        </a>
        <a
          href="https://www.linkedin.com/in/alfathafp/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-mono font-semibold text-zinc-300 bg-surface hover:bg-zinc-800 border border-zinc-700 transition-all"
        >
          <span>LinkedIn Profile</span>
          <Linkedin size={14} class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>
  </section>

  <!-- Experience Timeline Section -->
  <section class="mb-20">
    <div class="mb-8">
      <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-emerald-400 mb-1">
        Career History
      </h2>
      <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
        Companies & Roles
      </h3>
    </div>

    <div class="space-y-6">
      {sortedExperiences.map((exp) => (
        <ExperienceItem experience={exp} />
      ))}
    </div>
  </section>

  <!-- Comprehensive Skills Matrix Section -->
  <section class="mb-16">
    <div class="mb-8">
      <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-emerald-400 mb-1">
        Technical Competencies
      </h2>
      <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
        Skills by Domain
      </h3>
      <p class="text-sm text-zinc-400 mt-2 max-w-2xl">
        A breakdown of frameworks, tools, and testing practices I use to build maintainable automation suites.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {skillsMatrix.map((item) => (
        <div class="bg-surface border border-border rounded-xl p-6 hover:border-zinc-700 transition-all flex flex-col justify-between">
          <div>
            <h4 class="text-base font-semibold text-zinc-100 mb-1.5 flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
              <span>{item.domain}</span>
            </h4>
            <p class="text-xs text-zinc-400 mb-4 leading-relaxed">{item.description}</p>
          </div>
          <div class="flex flex-wrap gap-1.5 pt-3 border-t border-zinc-800/80">
            {item.skills.map((skill) => (
              <span class="px-2.5 py-1 text-xs font-mono bg-zinc-900/90 text-zinc-300 rounded border border-zinc-800">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
