---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found | Alfath Febriadi Pratama">
  <div class="py-20 text-center flex flex-col items-center justify-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-950/40 border border-red-800/40 text-red-400 text-xs font-mono mb-4">
      <span>HTTP 404: ASSERTION_FAILED</span>
    </div>
    <h1 class="text-6xl sm:text-7xl font-mono font-extrabold text-white tracking-tight mb-4">404</h1>
    <p class="text-lg text-zinc-400 max-w-md mx-auto mb-8 font-sans">
      The requested endpoint or resource could not be resolved in this staging environment.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-semibold font-mono text-sm transition-all"
    >
      <span>← Return to Home</span>
    </a>
  </div>
</BaseLayout>
