---
// Component to automatically attach copy-to-clipboard functionality to all pre / code blocks
---

<script>
  function setupCodeCopyButtons() {
    const preBlocks = document.querySelectorAll('pre');

    preBlocks.forEach((pre) => {
      // Check if button already exists
      if (pre.querySelector('.code-copy-btn')) return;

      // Skip mermaid diagram blocks — they are rendered as diagrams, not copyable code
      const codeEl = pre.querySelector('code');
      if (codeEl && codeEl.classList.contains('language-mermaid')) return;

      // Ensure pre is relatively positioned
      if (getComputedStyle(pre).position === 'static') {
        pre.style.position = 'relative';
      }

      // Create copy button
      const button = document.createElement('button');
      button.className =
        'code-copy-btn absolute top-2.5 right-2.5 px-2.5 py-1 text-xs font-mono rounded bg-zinc-800/90 hover:bg-zinc-700 text-zinc-300 border border-zinc-700/80 shadow-sm opacity-0 group-hover:opacity-100 transition-all duration-200 flex items-center gap-1.5 focus:opacity-100 focus:outline-none';
      button.setAttribute('aria-label', 'Copy code to clipboard');
      button.innerHTML = `
        <svg class="w-3.5 h-3.5 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <span class="copy-text">Copy</span>
      `;

      // Enable hover trigger on pre
      pre.classList.add('group');

      button.addEventListener('click', async (e) => {
        e.stopPropagation();
        const codeElement = pre.querySelector('code');
        const codeText = codeElement ? codeElement.innerText : pre.innerText;

        try {
          await navigator.clipboard.writeText(codeText.trim());
          
          button.classList.add('text-emerald-400', 'border-emerald-700', 'bg-emerald-950/80');
          button.innerHTML = `
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Copied!</span>
          `;

          setTimeout(() => {
            button.classList.remove('text-emerald-400', 'border-emerald-700', 'bg-emerald-950/80');
            button.innerHTML = `
              <svg class="w-3.5 h-3.5 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span class="copy-text">Copy</span>
            `;
          }, 2000);
        } catch (err) {
          console.error('Failed to copy text: ', err);
        }
      });

      pre.appendChild(button);
    });
  }

  // Run on initial page load
  setupCodeCopyButtons();

  // Support Astro View Transitions or dynamic navigation if enabled
  document.addEventListener('astro:page-load', setupCodeCopyButtons);
</script>
