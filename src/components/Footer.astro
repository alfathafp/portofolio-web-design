---
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-border bg-surface/50 text-zinc-400">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Identity -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <div class="h-2.5 w-2.5 rounded-full bg-emerald-500"></div>
          <span class="font-mono text-zinc-100 font-bold tracking-tight text-base">Alfath Febriadi Pratama</span>
        </div>
        <p class="text-sm text-zinc-400 max-w-sm leading-relaxed">
          Software Engineer in Test (SEIT / SDET) specializing in deterministic API test architectures, programmable mock ecosystems, and developer productivity tooling.
        </p>
        <div class="flex items-center gap-2 pt-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-mono bg-emerald-950/40 text-emerald-400 border border-emerald-800/40">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            Test Suites: 100% Passing
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-mono bg-zinc-900 text-zinc-400 border border-zinc-800">
            Jakarta, Indonesia
          </span>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-200 mb-4">Sitemap</h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/" class="hover:text-emerald-400 transition-colors">Overview</a>
          </li>
          <li>
            <a href="/projects" class="hover:text-emerald-400 transition-colors">Case Studies</a>
          </li>
          <li>
            <a href="/experience" class="hover:text-emerald-400 transition-colors">Experience & Skills</a>
          </li>
          <li>
            <a href="/about" class="hover:text-emerald-400 transition-colors">About & Philosophy</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Connect -->
      <div>
        <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-200 mb-4">Connect</h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a
              href="https://github.com/alfathafp"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 hover:text-emerald-400 transition-colors"
            >
              <span>GitHub</span>
              <svg class="w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/alfathafp/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 hover:text-emerald-400 transition-colors"
            >
              <span>LinkedIn</span>
              <svg class="w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="mailto:alfathafp@gmail.com"
              class="inline-flex items-center gap-2 hover:text-emerald-400 transition-colors"
            >
              <span>Email</span>
              <svg class="w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="/resume.pdf"
              target="_blank"
              class="inline-flex items-center gap-2 text-zinc-300 hover:text-emerald-400 font-mono text-xs transition-colors"
            >
              <span>Download Resume</span>
              <svg class="w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500 font-mono">
      <p>&copy; {year} Alfath Febriadi Pratama. Engineered for deterministic quality.</p>
      <div class="flex items-center gap-4">
        <span>Powered by Astro & Tailwind CSS</span>
        <button
          onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
          class="hover:text-zinc-300 text-zinc-500 transition-colors flex items-center gap-1"
          aria-label="Back to top"
        >
          <span>Top</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</footer>
