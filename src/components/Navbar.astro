---
import { Github, Linkedin, FileText, Menu, X } from 'lucide-astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { name: 'Overview', href: '/' },
  { name: 'Case Studies', href: '/projects' },
  { name: 'Experience', href: '/experience' },
  { name: 'About', href: '/about' },
];

const isActive = (href: string) => {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-50 w-full border-b border-border bg-background/85 backdrop-blur-md transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="group flex items-center gap-2.5 text-slate-100 font-mono font-semibold tracking-tight hover:text-white transition-colors">
      <div class="relative flex h-3 w-3 items-center justify-center">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </div>
      <span class="text-base text-zinc-100 group-hover:text-emerald-400 transition-colors">alfath<span class="text-emerald-400">.dev</span></span>
      <span class="hidden sm:inline-block text-xs uppercase px-1.5 py-0.5 rounded bg-zinc-800/80 text-zinc-400 border border-zinc-700/50 font-sans tracking-wider ml-1">SDET</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1">
      {
        navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class:list={[
                'px-3.5 py-1.5 rounded-md text-sm font-medium transition-all duration-200',
                active
                  ? 'text-emerald-400 bg-emerald-950/30 border border-emerald-800/50 shadow-sm'
                  : 'text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800/50',
              ]}
            >
              {link.name}
            </a>
          );
        })
      }
    </nav>

    <!-- Social Links & Action -->
    <div class="hidden md:flex items-center gap-3">
      <a
        href="https://github.com/alfathafp"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="p-2 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800/60 rounded-md transition-colors"
      >
        <Github size={20} class="w-5 h-5" />
      </a>

      <a
        href="https://www.linkedin.com/in/alfathafp/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn Profile"
        class="p-2 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800/60 rounded-md transition-colors"
      >
        <Linkedin size={20} class="w-5 h-5" />
      </a>

      <a
        href="/resume.pdf"
        target="_blank"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium font-mono text-zinc-100 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 rounded-md transition-all shadow-sm"
      >
        <span>CV / Resume</span>
        <FileText size={14} class="w-3.5 h-3.5 text-zinc-400" />
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        type="button"
        id="mobile-menu-button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        class="p-2 text-zinc-400 hover:text-white hover:bg-zinc-800 rounded-md focus:outline-none"
      >
        <Menu id="menu-icon" size={24} class="w-6 h-6" />
        <X id="close-icon" size={24} class="w-6 h-6 hidden" />
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-border bg-zinc-950/95 px-4 pt-2 pb-4 space-y-1">
    {
      navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            class:list={[
              'block px-3 py-2 rounded-md text-sm font-medium transition-colors',
              active
                ? 'text-emerald-400 bg-emerald-950/40 border border-emerald-800/40'
                : 'text-zinc-400 hover:text-white hover:bg-zinc-800/50',
            ]}
          >
            {link.name}
          </a>
        );
      })
    }
    <div class="pt-3 mt-2 border-t border-zinc-800 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <a
          href="https://github.com/alfathafp"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-zinc-400 hover:text-white hover:bg-zinc-800 rounded-md"
        >
          <Github size={20} class="w-5 h-5" />
        </a>
        <a
          href="https://www.linkedin.com/in/alfathafp/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-zinc-400 hover:text-white hover:bg-zinc-800 rounded-md"
        >
          <Linkedin size={20} class="w-5 h-5" />
        </a>
      </div>
      <a
        href="/resume.pdf"
        target="_blank"
        class="px-3 py-1.5 text-xs font-medium font-mono text-zinc-100 bg-zinc-800 border border-zinc-700 rounded-md"
      >
        View CV
      </a>
    </div>
  </div>
</header>

  <script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (btn && menu && menuIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      // Announce expanded/collapsed state to screen readers
      btn.setAttribute('aria-expanded', String(!isHidden));
      menuIcon.classList.toggle('hidden', !isHidden);
      closeIcon.classList.toggle('hidden', isHidden);
    });
  }
</script>
