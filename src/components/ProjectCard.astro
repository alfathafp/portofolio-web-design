---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project?: CollectionEntry<'projects'>;
  title?: string;
  description?: string;
  href?: string;
  tags?: string[];
  metrics?: { label: string; value: string; detail?: string }[];
  category?: string;
  featured?: boolean;
}

const { project, ...directProps } = Astro.props;

const title = project ? project.data.title : directProps.title || '';
const description = project ? project.data.description : directProps.description || '';
const href = project ? `/projects/${project.id.replace(/\.md$/, '')}` : directProps.href || '#';
const tags = project ? project.data.tags : directProps.tags || [];
const metrics = project ? project.data.metrics : directProps.metrics || [];
const featured = project ? project.data.featured : directProps.featured || false;
const category = project
  ? featured
    ? 'Flagship Architecture'
    : 'Developer Tools'
  : directProps.category || 'Case Study';
---

<div
  class:list={[
    'group relative rounded-2xl transition-all duration-300 flex flex-col justify-between overflow-hidden',
    featured
      ? 'bg-gradient-to-b from-zinc-900/90 to-surface border border-emerald-500/30 hover:border-emerald-500/60 shadow-lg hover:shadow-emerald-950/20 p-6 sm:p-8'
      : 'bg-surface/80 border border-border hover:border-zinc-700 hover:bg-surface-hover/80 p-6 sm:p-8',
  ]}
>
  {
    featured && (
      <div class="absolute top-0 right-0">
        <div class="bg-gradient-to-l from-emerald-500/20 to-transparent text-emerald-400 font-mono text-[11px] font-semibold tracking-wider px-3.5 py-1 rounded-bl-lg border-b border-l border-emerald-500/30 uppercase">
          ★ Flagship Project
        </div>
      </div>
    )
  }

  <div>
    <div class="flex items-center gap-2 mb-3">
      <span class="text-xs font-mono font-medium text-emerald-400 uppercase tracking-wider bg-emerald-950/40 px-2.5 py-0.5 rounded border border-emerald-800/30">
        {category}
      </span>
      {project?.data.role && (
        <span class="text-xs font-mono text-zinc-400 bg-zinc-900 px-2 py-0.5 rounded border border-zinc-800">
          {project.data.role}
        </span>
      )}
    </div>

    <h3 class="text-xl sm:text-2xl font-bold text-zinc-100 group-hover:text-emerald-300 transition-colors tracking-tight">
      <a href={href} class="focus:outline-none">
        {title}
      </a>
    </h3>

    <p class="mt-3 text-sm text-zinc-400 leading-relaxed max-w-2xl">
      {description}
    </p>

    <!-- Metrics row -->
    {
      metrics && metrics.length > 0 && (
        <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 pt-5 border-t border-zinc-800/60">
          {metrics.map((metric) => (
            <div class="bg-zinc-900/90 p-3 rounded-lg border border-zinc-800/80">
              <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider">{metric.label}</div>
              <div class="text-base font-mono font-bold text-emerald-400 mt-0.5">{metric.value}</div>
              {metric.detail && (
                <div class="text-[11px] text-zinc-400 mt-1 line-clamp-1 leading-snug">{metric.detail}</div>
              )}
            </div>
          ))}
        </div>
      )
    }
  </div>

  <div class="mt-8 pt-5 border-t border-zinc-800/50 flex flex-wrap items-center justify-between gap-4">
    <div class="flex flex-wrap gap-1.5">
      {
        tags.map((tag) => (
          <span class="px-2.5 py-0.5 text-xs font-mono text-zinc-400 bg-zinc-900 rounded border border-zinc-800">
            {tag}
          </span>
        ))
      }
    </div>

    <a
      href={href}
      class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-emerald-400 group-hover:text-emerald-300 transition-colors"
    >
      <span>Read Case Study</span>
      <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </a>
  </div>
</div>
